{
  "name": "illumina",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "db:setup": "tsx server/db/setup.ts",
    "db:seed": "tsx server/scripts/seed_sample.ts",
    "db:import-bible": "tsx server/scripts/import_full_bible.ts",
    "db:seed-devotionals": "tsx server/scripts/seed_devotional_tracks.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
